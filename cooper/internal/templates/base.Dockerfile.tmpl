# ============================================================================
# Build stage: compile cooper-x11-bridge from Go source
# ============================================================================
FROM golang:1.25-bookworm AS x11-bridge-builder

{{if .HasParentCA -}}
# Trust the outer proxy before package and source downloads start. The public
# CA is appended directly because a minimal stage has no update command yet.
COPY parent-cooper-ca.pem /usr/local/share/ca-certificates/cooper-parent-ca.crt
RUN mkdir -p /etc/ssl/certs && cat /usr/local/share/ca-certificates/cooper-parent-ca.crt >> /etc/ssl/certs/ca-certificates.crt
{{end}}
COPY x11-bridge-src/ /build/
WORKDIR /build
RUN go build -o /cooper-x11-bridge .

{{- if .HasGo}}
FROM golang:{{.GoVersion}}-bookworm
{{- else}}
FROM debian:bookworm-slim
{{- end}}

{{if .HasParentCA -}}
# Trust the outer proxy before package and source downloads start. The public
# CA is appended directly because a minimal stage has no update command yet.
COPY parent-cooper-ca.pem /usr/local/share/ca-certificates/cooper-parent-ca.crt
RUN mkdir -p /etc/ssl/certs && cat /usr/local/share/ca-certificates/cooper-parent-ca.crt >> /etc/ssl/certs/ca-certificates.crt
{{end}}

# A VM session needs the current shared entrypoint contract. Cooper checks this
# label before it exports an agent image into the guest.
LABEL {{.VMImageContractLabel}}="{{.VMImageContractVersion}}"

# ============================================================================
# Base tools installation (must come before Node.js — provides curl, xz-utils)
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    socat \
    git \
    curl \
    ca-certificates \
    xz-utils \
    ripgrep \
    jq \
    xclip \
    xsel \
    xauth \
    xvfb \
    fontconfig \
    fonts-dejavu-core \
    fonts-roboto \
    fonts-noto-core \
    fonts-noto-cjk \
    fonts-freefont-ttf \
    fonts-liberation \
    fonts-noto-color-emoji \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libfontconfig1 \
    libfreetype6 \
{{- if .HasOpenCode}}
    inotify-tools \
{{- end}}
{{- if .HasCodex}}
    build-essential \
    meson \
    ninja-build \
    pkg-config \
    libcap-dev \
{{- end}}
    && rm -rf /var/lib/apt/lists/*

# Install cooper-x11-bridge binary from build stage
COPY --from=x11-bridge-builder /cooper-x11-bridge /usr/local/bin/cooper-x11-bridge

# Node.js installation via official tarball (pinned version).
# Required for npm-based AI tools even when Node is not a programming tool.
# Docker 20.10+ injects TARGETARCH automatically during plain `docker build`,
# so Cooper can select the correct linux/amd64 vs linux/arm64 tarball without
# requiring buildx-specific logic.
ARG NODE_VERSION={{.NodeVersion}}
ARG TARGETARCH
RUN NODE_ARCH=$([ "$TARGETARCH" = "arm64" ] && echo "arm64" || echo "x64") && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
    && node --version && npm --version
{{if .HasPython}}
# ============================================================================
# Python installation
# ============================================================================
# Python: install distro-default version. Exact version pinning is not supported
# via apt (distro ships a fixed version). Use pyenv in Dockerfile.user for exact versions.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python
{{end -}}
{{- if .HasCodex}}
# ============================================================================
# Bubblewrap build from source (required by OpenAI Codex CLI --argv0 support)
# Debian bookworm ships an older version without this flag
# ============================================================================
RUN BWRAP_VERSION=0.11.0 && \
    BWRAP_TARBALL="bubblewrap-${BWRAP_VERSION}.tar.xz" && \
    curl -Lo "/tmp/${BWRAP_TARBALL}" \
        "https://github.com/containers/bubblewrap/releases/download/v${BWRAP_VERSION}/${BWRAP_TARBALL}" && \
    echo "988fd6b232dafa04b8b8198723efeaccdb3c6aa9c1c7936219d5791a8b7a8646  /tmp/${BWRAP_TARBALL}" | sha256sum -c && \
    mkdir -p /tmp/bwrap-build && cd /tmp/bwrap-build && \
    tar -xf "/tmp/${BWRAP_TARBALL}" && \
    cd "bubblewrap-${BWRAP_VERSION}" && \
    meson setup _builddir --prefix=/usr/local && \
    meson compile -C _builddir && \
    meson install -C _builddir && \
    ln -sf /usr/local/bin/bwrap /usr/bin/bwrap && \
    rm -rf /tmp/bwrap-build "/tmp/${BWRAP_TARBALL}"
{{end}}
# ============================================================================
# User setup - matching host UID/GID for file permissions
# ============================================================================
ARG USER_UID
ARG USER_GID
ARG USER_NAME
ARG USER_GROUP
ARG USER_HOME
ARG COOPER_ACCOUNT
LABEL cooper.account="${COOPER_ACCOUNT}"
ENV COOPER_USER_NAME=${USER_NAME} COOPER_USER_GROUP=${USER_GROUP}
ENV HOME=${USER_HOME} USER=${USER_NAME} LOGNAME=${USER_NAME} SHELL=/bin/bash
COPY setup-account.sh /usr/local/libexec/cooper-setup-account
RUN /bin/sh /usr/local/libexec/cooper-setup-account \
      "$USER_NAME" "$USER_GROUP" "$USER_UID" "$USER_GID" "$USER_HOME" \
    && mkdir -p /etc/cooper \
    && printf '%s\n' "$COOPER_ACCOUNT" > /etc/cooper/account.json \
    && chmod 0444 /etc/cooper/account.json

# Setup directories for user
RUN mkdir -p /opt/cooper/bin /opt/cooper/npm /var/lib/cooper/cache /var/lib/cooper/clipboard /go \
    && chown -R "$USER_UID:$USER_GID" /opt/cooper /var/lib/cooper /go

# Copy entrypoint and diagnostic script
COPY entrypoint.sh /entrypoint.sh
COPY doctor.sh /usr/local/bin/doctor.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/doctor.sh

# ============================================================================
# CA certificate injection for selectively inspected TLS traffic
# ============================================================================
COPY cooper-ca.pem /usr/local/share/ca-certificates/cooper-ca.crt
RUN update-ca-certificates && \
    chmod 666 /etc/ssl/certs/ca-certificates.crt && \
    chmod 666 /usr/local/share/ca-certificates/cooper-ca.crt

USER ${USER_NAME}

{{- if .HasGo}}
# Make Go's runtime cache locations explicit so barrel mounts and `go env`
# stay aligned even if upstream image defaults change.
ENV GOPATH={{.GoPath}}
ENV GOMODCACHE={{.GoModCache}}
ENV GOCACHE={{.GoBuildCache}}
{{- end}}

# Configure npm to use user-writable directory for global packages
ENV NPM_CONFIG_PREFIX=/opt/cooper/npm
ENV NPM_CONFIG_CACHE=/var/lib/cooper/cache/npm
ENV PIP_CACHE_DIR=/var/lib/cooper/cache/pip
ENV PYTHONUSERBASE=/opt/cooper/python
ENV PATH=/opt/cooper/bin:/opt/cooper/npm/bin:/opt/cooper/python/bin{{- if .HasGo}}:{{.GoBinDir}}{{- end}}:$PATH
# Node uses its own CA set by default. Include both the current and outer
# Cooper CA from the system bundle for nested build downloads.
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# ============================================================================
# Implicit language-server tooling
# ============================================================================
# Keep these installs after USER/PATH/npm-prefix setup because they are user-
# scoped installs, but before runtime proxy env vars because cooper-proxy does
# not exist during docker build.
{{- if .GoLSPVersion}}
# Use the image Go only. auto would download a newer moving toolchain when
# gopls's go.mod directive is ahead of the configured Go (for example gopls
# v0.23 needs Go 1.26 while Cooper fixtures still install Go 1.24).
# Use only Go's official module proxy and checksum database. A proxy list does
# not advance after a timeout, and direct source mode would still use Google's
# vanity and source hosts while weakening the simple trust boundary.
# Run fresh, bounded attempts instead: this tolerates short destination-specific
# routing failures, retains completed downloads in the module cache, and cannot
# leave a Docker layer waiting indefinitely on a half-open transfer.
RUN set -eu; \
    export GOTOOLCHAIN=local \
      GOBIN=/opt/cooper/bin \
      GOPROXY=https://proxy.golang.org \
      GOSUMDB=sum.golang.org; \
    attempt=1; \
    max_attempts=8; \
    while ! timeout --signal=TERM --kill-after=10s 2m \
        go install golang.org/x/tools/gopls@{{.GoLSPVersion}}; do \
      if [ "$attempt" -ge "$max_attempts" ]; then \
        echo "gopls install failed after $attempt attempts using proxy.golang.org" >&2; \
        exit 1; \
      fi; \
      delay=$((attempt * 5)); \
      echo "gopls install attempt $attempt/$max_attempts failed; retrying official proxy in ${delay}s" >&2; \
      sleep "$delay"; \
      attempt=$((attempt + 1)); \
    done; \
    gopls version
{{- end}}
{{- if .NodeTSLSPVersion}}
RUN npm install -g \
    typescript@{{.NodeTypeScriptVersion}} \
    typescript-language-server@{{.NodeTSLSPVersion}} \
    && typescript-language-server --version \
    && tsc --version
{{- end}}
{{- if .PythonPyrightVersion}}
RUN npm install -g pyright@{{.PythonPyrightVersion}} \
    && pyright --version \
    && command -v pyright-langserver
{{- end}}
{{- if .PythonPylspVersion}}
# python-lsp-server follows the configured Python version, but Cooper still
# installs Debian's default python3 runtime in the image.
RUN python3 -m pip install --user "python-lsp-server=={{.PythonPylspVersion}}" \
    --break-system-packages \
    && command -v pylsp \
    && python3 -m pip show python-lsp-server
{{- end}}

# ============================================================================
# Proxy environment variables
# ============================================================================
ENV HTTP_PROXY=http://cooper-proxy:{{.ProxyPort}}
ENV HTTPS_PROXY=http://cooper-proxy:{{.ProxyPort}}
ENV NO_PROXY=localhost,127.0.0.1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
