# Cooper CLI: ChatGPT - Generated by cooper configure
# DO NOT EDIT - This file is regenerated by Cooper.
FROM {{.BaseImage}}

USER root
ENV HTTP_PROXY="" HTTPS_PROXY=""

# A private desktop, browser, and session bus keep login dialogs and shell
# commands inside the same execution and network boundary as the app.
RUN apt-get update && apt-get install -y --no-install-recommends \
    dbus-x11 openbox tigervnc-standalone-server novnc python3-websockify \
    xterm fonts-dejavu-core chromium libnss3-tools x11-utils xdotool gnome-keyring libsecret-tools \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
RUN set -eu; \
    desktop_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$desktop_arch" in \
      amd64) app_url='{{.AMD.URL}}'; app_digest='{{.AMD.SHA256}}'; app_size='{{.AMD.Size}}' ;; \
      arm64) app_url='{{.ARM.URL}}'; app_digest='{{.ARM.SHA256}}'; app_size='{{.ARM.Size}}' ;; \
      *) echo "Unsupported ChatGPT architecture: $desktop_arch" >&2; exit 1 ;; \
    esac; \
    curl --fail --show-error --silent --location --retry 3 --connect-timeout 30 --max-time 900 \
      "$app_url" --output /tmp/chatgpt.deb; \
    test "$(stat -c %s /tmp/chatgpt.deb)" = "$app_size"; \
    if [ -n "$app_digest" ]; then printf '%s  %s\n' "$app_digest" /tmp/chatgpt.deb | sha256sum -c -; fi; \
    test "$(dpkg-deb --field /tmp/chatgpt.deb Package)" = chatgpt; \
    test "$(dpkg-deb --field /tmp/chatgpt.deb Version)" = '{{.Version}}'; \
    test "$(dpkg-deb --field /tmp/chatgpt.deb Architecture)" = "$desktop_arch"; \
    apt-get update; \
    apt-get install -y /tmp/chatgpt.deb; \
    rm /tmp/chatgpt.deb; \
    rm -rf /var/lib/apt/lists/*

COPY desktop/ /opt/cooper/desktop/
# Keep the official metadata beside the wrapper so a nested Cooper can read
# the installed version for Mirror without starting the desktop application.
RUN chmod 0755 /opt/cooper/desktop/*.sh \
    && ln -s /usr/lib/chatgpt/resources /opt/cooper/desktop/resources \
    && sed -i 's|^Exec=.*|Exec=/opt/cooper/bin/chatgpt %U|' /usr/share/applications/chatgpt.desktop \
    && ln -s /opt/cooper/desktop/chatgpt.sh /opt/cooper/bin/chatgpt \
    && ln -s /opt/cooper/desktop/browser.sh /opt/cooper/bin/cooper-browser \
    && ln -s /opt/cooper/desktop/start.sh /opt/cooper/bin/cooper-desktop-start \
    && ln -s /opt/cooper/desktop/stop.sh /opt/cooper/bin/cooper-desktop-stop \
    && mkdir -p "$HOME/.codex" "$HOME/.config/Codex" \
    && mkdir -p /var/lib/cooper/desktop \
    && chown -R "$COOPER_USER_NAME:$COOPER_USER_GROUP" /var/lib/cooper/desktop \
    && chown -R "$COOPER_USER_NAME:$COOPER_USER_GROUP" "$HOME"

USER ${COOPER_USER_NAME}
ENV HTTP_PROXY=http://cooper-proxy:{{.ProxyPort}}
ENV HTTPS_PROXY=http://cooper-proxy:{{.ProxyPort}}
ENV NO_PROXY=localhost,127.0.0.1
ENV COOPER_CLI_TOOL=chatgpt COOPER_CLI_EXECUTABLE=chatgpt COOPER_CLI_AUTO_APPROVE=""
ENV COOPER_CLIPBOARD_MODE=x11 COOPER_DESKTOP=1
ENV BROWSER=/opt/cooper/bin/cooper-browser
ENV LANG=C.UTF-8
ENV CODEX_CLI_PATH=/opt/cooper/desktop/core.sh
